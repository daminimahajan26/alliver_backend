PORT=4000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://www.allivermarketing.in,https://allivermarketing.in
JWT_SECRET=change-me-to-a-long-random-string
# Admin account created automatically on first run
ADMIN_EMAIL=admin@allivermarketing.in
ADMIN_PASSWORD=ChangeThisNow!123
DB_PATH=./data/alliver.db
# Email notifications for new leads (optional - leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ALLIVER <no-reply@allivermarketing.in>"
NOTIFY_TO=hello@allivermarketing.in
